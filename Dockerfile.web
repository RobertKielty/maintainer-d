FROM node:20-alpine AS deps
WORKDIR /app
ARG NPM_CONFIG_LOGLEVEL
ARG NPM_CONFIG_REGISTRY
ENV NPM_CONFIG_LOGLEVEL=$NPM_CONFIG_LOGLEVEL
ENV NPM_CONFIG_REGISTRY=$NPM_CONFIG_REGISTRY
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_BFF_BASE_URL
ENV NEXT_PUBLIC_BFF_BASE_URL=$NEXT_PUBLIC_BFF_BASE_URL
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
RUN npm run build && npm prune --omit=dev

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ARG NEXT_PUBLIC_BFF_BASE_URL
ENV NEXT_PUBLIC_BFF_BASE_URL=$NEXT_PUBLIC_BFF_BASE_URL
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
# `next start` reads next.config.mjs at runtime; without it images.remotePatterns
# is empty and /_next/image rejects GitHub avatars with a 400.
COPY --from=builder /app/next.config.mjs ./next.config.mjs
RUN node --input-type=module -e "const { default: c } = await import('/app/next.config.mjs'); if (!c.images?.remotePatterns?.some((p) => p.hostname === 'github.com')) { console.error('next.config.mjs does not allow github.com images'); process.exit(1); }"
EXPOSE 3000
CMD ["npm", "run", "start"]
