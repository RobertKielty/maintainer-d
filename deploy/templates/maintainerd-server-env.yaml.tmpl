apiVersion: v1
kind: Secret
metadata:
  name: maintainerd-server-env
  namespace: maintainerd
type: Opaque
stringData:
  GITHUB_API_TOKEN: ${GITHUB_API_TOKEN}
  GITHUB_WEBHOOK_SECRET: ${GITHUB_WEBHOOK_SECRET}
  FOSSA_API_TOKEN: ${FOSSA_API_TOKEN}
  ORG: ${ORG}
  REPO: ${REPO}
  # LFX M2M client for dot-project-sync; it mints a short-lived api-gw token
  # each run. No LFX token is ever stored here.
  LFX_CLIENT_ID: ${LFX_CLIENT_ID}
  LFX_CLIENT_SECRET: ${LFX_CLIENT_SECRET}
